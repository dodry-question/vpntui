#!/usr/bin/python3
"""vpntui root-хелпер: запускает приложение в отдельном network namespace,
весь трафик которого идёт через Xray (TUN + slirp4netns).

Вызывается ТОЛЬКО через sudo (NOPASSWD) из пользовательского run-vpn.
Запрос читает из stdin (JSON):
  {"config": {...xray config...}, "tun": {...}, "server": {...},
   "cmd": ["brave-browser-stable"], "cwd": "/home/user", "env": {...}}

Приложение всегда запускается от имени вызывающего пользователя
(SUDO_UID/SUDO_GID), root-права нужны только на создание namespace,
TUN-интерфейса и маршрутов.
"""
import grp
import ipaddress
import json
import os
import pathlib
import pwd
import re
import select
import shlex
import shutil
import signal
import subprocess
import sys
import time

RUN_DIR = pathlib.Path("/run/vpntui")
SESS_DIR = RUN_DIR / "sessions"
MAX_ENV_LEN = 4096

# Global (whole-host) TUN mode.  The service must run as root: creating a TUN
# device and replacing the default route needs CAP_NET_ADMIN.
SYSTEM_CORE = pathlib.Path("/usr/local/lib/vpntui/core/current/xray")
GLOBAL_DIR = pathlib.Path("/etc/vpntui")
GLOBAL_CONFIG = GLOBAL_DIR / "xray-global.json"
GLOBAL_UNIT = pathlib.Path("/etc/systemd/system/vpntui-xray.service")
GLOBAL_SERVICE = "vpntui-xray.service"
GLOBAL_WATCHDOG = "vpntui-xray-watchdog"
MAX_CONFIG_LEN = 1_000_000

TUN_ADDR = "198.18.0.1/30"
TUN_ROUTES = ["0.0.0.0/0"]
INBOUND_TAGS = {"tun-in", "socks", "http"}
OUTBOUND_TAGS = {"proxy", "direct"}
PROXY_PROTOCOLS = {"vless", "vmess", "trojan", "shadowsocks", "hysteria2"}
LOG_LEVELS = {"debug", "info", "warning", "error", "none"}
DNS_STRATEGIES = {"UseIP", "UseIPv4", "UseIPv6"}
ROUTE_STRATEGIES = {"AsIs", "IPIfNonMatch", "IPOnDemand"}
FREEDOM_STRATEGIES = {"AsIs", "UseIP", "UseIPv4", "UseIPv6"}


class SetupError(Exception):
    pass


def msg(text):
    print(text, file=sys.stderr, flush=True)


_EMOJI = None


def clean(text):
    """Срезаем эмодзи/флаги — в терминале/уведомлениях они дают «тофу»."""
    global _EMOJI
    if _EMOJI is None:
        _EMOJI = re.compile(
            "[\U0001F000-\U0001FAFF\U00002600-\U000027BF\U00002190-\U000021FF"
            "\U0000FE00-\U0000FE0F\U0000200D\U000020E3\U00002B00-\U00002BFF]+"
        )
    return re.sub(r"\s+", " ", _EMOJI.sub(" ", text or "")).strip(" -—·|")


def run(args, **kw):
    r = subprocess.run(args, capture_output=True, text=True, **kw)
    if r.returncode != 0:
        raise SetupError(
            f"команда {' '.join(args)} завершилась с кодом {r.returncode}\n"
            f"{(r.stderr or r.stdout).strip()}"
        )
    return r


def sanitize_env(raw, home, user, group):
    """Пропускаем только «безопасные» переменные окружения."""
    exact = {
        "HOME", "USER", "LOGNAME", "SHELL", "PATH", "TERM", "COLORTERM",
        "DISPLAY", "XAUTHORITY", "WAYLAND_DISPLAY", "XDG_RUNTIME_DIR",
        "XDG_SESSION_TYPE", "XDG_SESSION_DESKTOP", "XDG_CURRENT_DESKTOP",
        "XDG_DATA_DIRS", "XDG_CONFIG_DIRS", "XDG_CACHE_HOME",
        "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_STATE_HOME",
        "DBUS_SESSION_BUS_ADDRESS", "SWAYSOCK", "I3SOCK", "HYPRLAND_INSTANCE_SIGNATURE",
        "PULSE_SERVER", "PULSE_COOKIE", "PIPEWIRE_REMOTE", "SSH_AUTH_SOCK",
        "TMPDIR", "LANG", "LANGUAGE", "MOZ_ENABLE_WAYLAND",
        "QT_QPA_PLATFORM", "GDK_BACKEND", "GTK_THEME", "ICON_THEME",
        "BROWSER", "EDITOR", "VISUAL", "FLATPAK_BWRAP", "GTK_USE_PORTAL",
    }
    prefixes = ("LC_", "QT_", "GTK_", "GDK_")

    env = {
        "HOME": home,
        "USER": user,
        "LOGNAME": user,
        "SHELL": "/bin/bash",
        "PATH": "/usr/local/bin:/usr/bin:/bin",
        "LANG": "C.UTF-8",
    }
    for k, v in (raw or {}).items():
        if not isinstance(k, str) or not isinstance(v, str):
            continue
        if len(k) > 128 or len(v) > MAX_ENV_LEN or "\x00" in k + v:
            continue
        if k in exact or k.startswith(prefixes):
            env[k] = v
    # HOME/PATH/USER всегда наши
    env["HOME"] = home
    env["USER"] = user
    env["LOGNAME"] = user
    return env


def start_slirp(ns, log):
    """slirp4netns: userspace-шлюз наружу. Ждём сигнала готовности."""
    r, w = os.pipe()
    try:
        p = subprocess.Popen(
            ["slirp4netns", "--netns-type=path", f"/run/netns/{ns}",
             "--configure", "--mtu=65520", "--disable-host-loopback",
             "--ready-fd", str(w), "tap0"],
            pass_fds=(w,), stdout=log, stderr=log, close_fds=True,
        )
    finally:
        os.close(w)
    ready, _, _ = select.select([r], [], [], 20)
    os.close(r)
    if not ready:
        p.kill()
        raise SetupError("slirp4netns не поднял сеть за 20 секунд")
    return p


def wait_link(ns, iface, timeout=15.0):
    deadline = time.time() + timeout
    while time.time() < deadline:
        r = subprocess.run(["ip", "netns", "exec", ns, "ip", "-o", "link", "show", iface],
                           capture_output=True, text=True)
        if r.returncode == 0:
            return
        time.sleep(0.1)
    raise SetupError(f"интерфейс {iface} не появился")


def ns_ip(ns, *args):
    return run(["ip", "netns", "exec", ns, "ip", *args])


def health_check(ns):
    last = ""
    for _ in range(3):
        r = subprocess.run(
            ["ip", "netns", "exec", ns, "curl", "-sS", "--connect-timeout", "8",
             "-m", "15", "https://api.ipify.org"],
            capture_output=True, text=True,
        )
        out = (r.stdout or "").strip()
        if r.returncode == 0 and out.count(".") == 3 and len(out) < 20:
            return out
        last = (r.stderr or r.stdout or "").strip()
        time.sleep(2)
    raise SetupError("нет связи через VPN (проверь сервер/подписку): " + last)


def _get(ns, url):
    r = subprocess.run(
        ["ip", "netns", "exec", ns, "curl", "-sS", "--connect-timeout", "6",
         "-m", "10", url],
        capture_output=True, text=True,
    )
    return (r.stdout or "").strip() if r.returncode == 0 else ""


def detect_country(ns, ip):
    """Страна выхода (по самому IP, запрос идёт через туннель)."""
    cc = _get(ns, f"https://ipinfo.io/{ip}/country")
    if re.fullmatch(r"[A-Z]{2}", cc):
        return cc
    js = _get(ns, f"https://api.country.is/{ip}")
    try:
        cc = json.loads(js).get("country") or ""
        if re.fullmatch(r"[A-Z]{2}", cc):
            return cc.upper()
    except Exception:
        pass
    js = _get(ns, f"https://ipwho.is/{ip}")
    try:
        cc = json.loads(js).get("country_code") or ""
        if re.fullmatch(r"[A-Z]{2}", cc):
            return cc.upper()
    except Exception:
        pass
    return ""


def write_session(path, data):
    """Пишем состояние сессии атомарно, чтобы TUI не читал полуфайл."""
    try:
        tmp = path.with_name(path.name + ".tmp")
        tmp.write_text(json.dumps(data, ensure_ascii=False))
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    except Exception:
        pass


def cleanup_stale_sessions():
    """Убираем записи сессий, чьи процессы/namespace уже умерли."""
    try:
        SESS_DIR.mkdir(mode=0o755, exist_ok=True)
        for f in SESS_DIR.glob("*.json"):
            try:
                d = json.loads(f.read_text())
            except Exception:
                f.unlink(missing_ok=True)
                continue
            pid = d.get("app_pid")
            ns = d.get("ns") or ""
            alive = bool(pid) and os.path.exists(f"/proc/{pid}")
            if ns and not pathlib.Path("/run/netns", ns).exists():
                alive = False
            if not alive:
                f.unlink(missing_ok=True)
    except Exception:
        pass


def notify_user(env, uid, gid, title, body):
    exe = shutil.which("notify-send")
    if not exe:
        return
    try:
        subprocess.Popen(
            ["setpriv", f"--reuid={uid}", f"--regid={gid}", "--init-groups",
             "--", exe, "-a", "vpntui", "-i", "network-vpn", title, body],
            env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
    except Exception:
        pass


# ---------------------------------------------------------------- global mode

def _root_owned(path):
    try:
        return os.stat(path).st_uid == 0
    except OSError:
        return False


def global_core():
    """Only a root-owned Xray may be started as root."""
    candidates = [SYSTEM_CORE, shutil.which("xray")]
    for candidate in candidates:
        if not candidate:
            continue
        path = str(pathlib.Path(candidate).resolve())
        if os.access(path, os.X_OK) and _root_owned(path):
            return path
    raise SetupError(
        "нет root-овского Xray: установи его командой `vpntui core install --system`"
    )


def _str_list(value, limit=64, length=300):
    return (
        isinstance(value, list)
        and len(value) <= limit
        and all(isinstance(item, str) and 0 < len(item) <= length for item in value)
    )


def _ip_list(value):
    if not _str_list(value, limit=32):
        return False
    try:
        for item in value:
            ipaddress.ip_address(item)
    except ValueError:
        return False
    return True


def _cidr_list(value, allowed):
    if not _str_list(value, limit=8):
        return False
    return all(item in allowed for item in value)


def validate_global_config(cfg):
    """Reject anything a root Xray should not do.

    The config comes from the unprivileged TUI, so it is a security boundary:
    only loopback/tun inbounds, known outbound protocols, no file logging and
    no API/stats/policy sections are accepted.
    """
    def expect(cond, text):
        if not cond:
            raise SetupError(f"недопустимый конфиг: {text}")

    expect(isinstance(cfg, dict), "ожидался объект")
    expect(set(cfg) <= {"log", "dns", "inbounds", "outbounds", "routing"},
           f"лишние разделы: {sorted(set(cfg) - {'log', 'dns', 'inbounds', 'outbounds', 'routing'})}")

    log = cfg.get("log", {})
    expect(isinstance(log, dict) and set(log) <= {"loglevel"}, "log")
    expect(log.get("loglevel", "warning") in LOG_LEVELS, "log.loglevel")

    if "dns" in cfg:
        dns = cfg["dns"]
        expect(isinstance(dns, dict) and set(dns) <= {"servers", "queryStrategy"}, "dns")
        expect(_ip_list(dns.get("servers", [])), "dns.servers")
        expect(dns.get("queryStrategy", "UseIPv4") in DNS_STRATEGIES, "dns.queryStrategy")

    inbounds = cfg.get("inbounds")
    expect(isinstance(inbounds, list) and 0 < len(inbounds) <= 4, "inbounds")
    seen_tags = set()
    for inbound in inbounds:
        expect(isinstance(inbound, dict), "inbound")
        expect(set(inbound) <= {"tag", "protocol", "listen", "port", "settings"},
               f"inbound keys: {sorted(set(inbound))}")
        tag, proto = inbound.get("tag"), inbound.get("protocol")
        expect(tag in INBOUND_TAGS, f"inbound tag {tag!r}")
        expect(proto == "tun" or proto in {"socks", "http"}, f"inbound protocol {proto!r}")
        expect(tag not in seen_tags, f"повторный tag {tag!r}")
        seen_tags.add(tag)
        settings = inbound.get("settings", {})
        expect(isinstance(settings, dict), "inbound settings")
        if proto == "tun":
            expect(set(settings) <= {"name", "address", "mtu", "stack", "strictRoute",
                                     "sniff", "autoSystemRoutingTable"}, "tun settings")
            expect(re.fullmatch(r"[a-z0-9_]{1,15}", str(settings.get("name", ""))), "tun.name")
            expect(settings.get("address") == [TUN_ADDR], f"tun.address должно быть {TUN_ADDR}")
            expect(isinstance(settings.get("mtu", 1500), int)
                   and 1280 <= settings.get("mtu", 1500) <= 9000, "tun.mtu")
            expect(settings.get("stack", "system") in {"system", "gvisor"}, "tun.stack")
            expect(settings.get("strictRoute", False) is True, "tun.strictRoute")
            expect(_cidr_list(settings.get("autoSystemRoutingTable", TUN_ROUTES), TUN_ROUTES),
                   "tun.autoSystemRoutingTable")
            sniff = settings.get("sniff", {})
            expect(isinstance(sniff, dict) and set(sniff) <= {"enabled", "destOverride"},
                   "tun.sniff")
            expect(sniff.get("enabled", True) is True, "tun.sniff.enabled")
            expect(set(sniff.get("destOverride", ["http", "tls"])) <= {"http", "tls", "quic"},
                   "tun.sniff.destOverride")
        else:
            expect(inbound.get("listen") == "127.0.0.1", f"{tag}: только loopback")
            port = inbound.get("port")
            expect(isinstance(port, int) and 1024 <= port <= 65535, f"{tag}: порт")
            allowed = {"udp"} if proto == "socks" else {"timeout"}
            expect(set(settings) <= allowed, f"{tag}: settings")

    outbounds = cfg.get("outbounds")
    expect(isinstance(outbounds, list) and 0 < len(outbounds) <= 4, "outbounds")
    tags = set()
    for outbound in outbounds:
        expect(isinstance(outbound, dict), "outbound")
        expect(set(outbound) <= {"tag", "protocol", "settings", "streamSettings",
                                 "sockopt", "sendThrough", "proxySettings"},
               f"outbound keys: {sorted(set(outbound))}")
        tag, proto = outbound.get("tag"), outbound.get("protocol")
        expect(tag in OUTBOUND_TAGS, f"outbound tag {tag!r}")
        expect(tag not in tags, f"повторный outbound tag {tag!r}")
        tags.add(tag)
        expect(proto in PROXY_PROTOCOLS or proto == "freedom", f"outbound protocol {proto!r}")
        settings = outbound.get("settings", {})
        expect(isinstance(settings, dict), "outbound settings")
        if proto == "freedom":
            expect(set(settings) <= {"domainStrategy"}, "freedom settings")
            expect(settings.get("domainStrategy", "AsIs") in FREEDOM_STRATEGIES,
                   "freedom.domainStrategy")
        sockopt = outbound.get("sockopt", {})
        expect(isinstance(sockopt, dict) and set(sockopt) <= {"mark", "domainStrategy"},
               "outbound sockopt")
        expect(isinstance(sockopt.get("mark", 0), int), "sockopt.mark")
        expect(isinstance(outbound.get("streamSettings", {}), dict), "streamSettings")
    expect("proxy" in tags, "нет outbound с tag proxy")

    routing = cfg.get("routing", {})
    expect(isinstance(routing, dict) and set(routing) <= {"domainStrategy", "rules"}, "routing")
    expect(routing.get("domainStrategy", "AsIs") in ROUTE_STRATEGIES, "routing.domainStrategy")
    rules = routing.get("rules", [])
    expect(isinstance(rules, list) and len(rules) <= 64, "routing.rules")
    for rule in rules:
        expect(isinstance(rule, dict), "rule")
        expect(set(rule) <= {"type", "ip", "domain", "protocol", "network",
                             "outboundTag", "inboundTag"}, f"rule keys: {sorted(set(rule))}")
        expect(rule.get("type") == "field", "rule.type")
        expect(rule.get("outboundTag") in OUTBOUND_TAGS, "rule.outboundTag")
        for key in ("ip", "domain", "protocol"):
            if key in rule:
                expect(_str_list(rule[key]), f"rule.{key}")
        if "network" in rule:
            expect(rule["network"] in {"tcp", "udp", "tcp,udp", "udp,tcp"}, "rule.network")
        if "inboundTag" in rule:
            expect(set(rule["inboundTag"]) <= INBOUND_TAGS, "rule.inboundTag")


def _systemctl(*args, check=False):
    result = subprocess.run(["systemctl", *args], capture_output=True, text=True)
    if check and result.returncode != 0:
        raise SetupError(
            f"systemctl {' '.join(args)}: {(result.stderr or result.stdout).strip()}"
        )
    return result


def _service_active():
    return _systemctl("is-active", GLOBAL_SERVICE).stdout.strip() == "active"


# --------------------------------------------------------- zapret exclusion

ZAPRET_DROPIN = pathlib.Path("/etc/systemd/system/zapret.service.d/50-vpntui-exclude.conf")
ZAPRET_SCRIPT_DIRS = (pathlib.Path("/usr/local/lib/vpntui"), pathlib.Path("/run/vpntui"))
ZAPRET_UNIT_DIRS = ("/etc/systemd/system", "/usr/lib/systemd/system", "/lib/systemd/system")
TUN_NAME = "vpntui0"

ZAPRET_SCRIPT_TEXT = """#!/bin/sh
# vpntui: keep zapret's DPI desync away from the tunnel device.
# zapret rewrites the TLS ClientHello of outbound packets, which breaks every
# site in its hostlists when the packet is already inside the vpntui tunnel.
# Idempotent and safe to run repeatedly (systemd ExecStartPost and the vpntui
# helper both call it).
set -u
TUN="${1:-vpntui0}"
TABLES=$(nft list tables 2>/dev/null | sed -n 's/^table inet \\([^ ]*zapret[^ ]*\\).*/\\1/p')
[ -n "$TABLES" ] || TABLES=zapret
for T in $TABLES; do
    CHAINS=$(nft list table inet "$T" 2>/dev/null \\
        | sed -n 's/^[[:space:]]*chain \\([^ ]*\\) .*/\\1/p')
    for ch in $CHAINS; do
        BODY=$(nft list chain inet "$T" "$ch" 2>/dev/null) || continue
        insert=0
        case "$ch" in postrouting*) insert=1 ;; esac
        case "$BODY" in *"hook postrouting"*) insert=1 ;; esac
        [ "$insert" = 1 ] || continue
        printf '%s' "$BODY" | grep -q "oifname \\"$TUN\\"" && continue
        nft insert rule inet "$T" "$ch" oifname "$TUN" return 2>/dev/null || true
    done
done
# iptables-based zapret (older installations).
if command -v iptables >/dev/null 2>&1; then
    if iptables -t mangle -S 2>/dev/null | grep -q NFQUEUE; then
        iptables -t mangle -C POSTROUTING -o "$TUN" -j RETURN 2>/dev/null \\
            || iptables -t mangle -I POSTROUTING 1 -o "$TUN" -j RETURN 2>/dev/null \\
            || true
    fi
fi
exit 0
"""

ZAPRET_DROPIN_TEXT = """[Service]
# vpntui: after zapret recreates its rules, keep the tunnel out of them.
# Managed by vpntui; removed by `vpntui uninstall`.
# The leading "-" keeps zapret starting even if the helper is not there yet
# (NixOS keeps it in /run, which is empty right after boot).
ExecStartPost=-{script}
"""


def _script_dir():
    """First writable directory for the zapret helper.

    ``/usr/local/lib/vpntui`` on a normal distribution, ``/run/vpntui`` on
    NixOS where ``/usr/local`` is not managed and may be read-only.
    """
    for base in ZAPRET_SCRIPT_DIRS:
        try:
            base.mkdir(parents=True, exist_ok=True)
            probe = base / ".vpntui-write-test"
            probe.write_text("")
            probe.unlink()
            return base
        except OSError:
            continue
    return None


def _write_if_changed(path, text, mode=None):
    try:
        if path.is_file() and path.read_text() == text:
            return False
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(text)
        if mode is not None:
            path.chmod(mode)
        return True
    except OSError:
        return False


def _zapret_units():
    return [pathlib.Path(d) / "zapret.service" for d in ZAPRET_UNIT_DIRS]


def _zapret_tables():
    """Names of nft tables that look like zapret (needs root)."""
    tables = []
    if shutil.which("nft"):
        result = subprocess.run(["nft", "list", "tables"],
                                capture_output=True, text=True)
        for line in (result.stdout or "").splitlines():
            match = re.match(r"^table\s+inet\s+(\S+)", line.strip())
            if match and "zapret" in match.group(1):
                tables.append(match.group(1))
    if tables:
        return tables
    if any(unit.is_file() for unit in _zapret_units()):
        return ["zapret"]
    return []


def ensure_zapret_exclusion(tun=TUN_NAME):
    """Exclude the vpntui TUN from zapret's desync, persistently.

    Installs the helper script and a systemd drop-in so the exclusion comes
    back after ``systemctl restart zapret`` and after reboot, then applies it
    to the live nftables/iptables rules.  Returns True when zapret is present.
    """
    if not _zapret_tables():
        return False
    base = _script_dir()
    if base is None:
        return False
    script = base / "zapret-exclude-tun"
    changed = _write_if_changed(script, ZAPRET_SCRIPT_TEXT, 0o755)
    changed = _write_if_changed(
        ZAPRET_DROPIN,
        ZAPRET_DROPIN_TEXT.format(script=script), 0o644) or changed
    if changed:
        _systemctl("daemon-reload")
    subprocess.run([str(script), tun], capture_output=True, text=True)
    return True


# ------------------------------------------------------- tunnel verification

def _curl_code(url, timeout=6):
    curl = shutil.which("curl")
    if not curl:
        return ""
    result = subprocess.run(
        [curl, "-s", "-m", str(timeout), "-o", "/dev/null", "-w", "%{http_code}", url],
        capture_output=True, text=True,
    )
    return (result.stdout or "").strip()


def _curl_body(url, timeout=6):
    curl = shutil.which("curl")
    if not curl:
        return ""
    result = subprocess.run([curl, "-s", "-m", str(timeout), url],
                            capture_output=True, text=True)
    return (result.stdout or "").strip()


def _default_devices():
    result = subprocess.run(["ip", "route", "show", "default"],
                            capture_output=True, text=True)
    devices = []
    for line in (result.stdout or "").splitlines():
        match = re.search(r"\bdev\s+(\S+)", line)
        if match:
            devices.append(match.group(1))
    return devices


def verify_tunnel(tun=TUN_NAME, attempts=3):
    """Prove that traffic really leaves through the tunnel.

    A running service is not enough: a foreign default route, a port clash or
    a dead upstream still leave the interface "active" while every packet
    goes nowhere.  Returns a dict; raises SetupError when the tunnel is dead.
    """
    for _ in range(10):
        if pathlib.Path(f"/sys/class/net/{tun}").exists():
            break
        time.sleep(0.3)
    if not pathlib.Path(f"/sys/class/net/{tun}").exists():
        raise SetupError(f"интерфейс {tun} не появился")

    devices = _default_devices()
    if tun not in devices:
        raise SetupError(
            "сервис запущен, но default-маршрут не смотрит в туннель "
            f"(default: {', '.join(devices) or 'нет'}). "
            "Обычно это WARP или другой VPN, который перехватил маршруты."
        )

    codes = []
    for attempt in range(max(1, attempts)):
        code = _curl_code("https://api.ipify.org")
        codes.append(code or "000")
        if code == "200":
            return {"verified": True, "exit_ip": _curl_body("https://api.ipify.org"),
                    "probes": codes, "default": devices}
        if attempt + 1 < attempts:
            time.sleep(2)
    raise SetupError(
        "туннель поднялся, но трафик через него не проходит "
        f"(проверки: {', '.join(codes)}). Сервис остановлен, интернет должен "
        "вернуться. Проверь сервер, DNS и конфликты: vpntui doctor"
    )



def _cancel_watchdog():
    _systemctl("stop", f"{GLOBAL_WATCHDOG}.timer")
    _systemctl("reset-failed", f"{GLOBAL_WATCHDOG}.timer")


def _write_unit(core):
    unit = (
        "[Unit]\n"
        "Description=vpntui global Xray (TUN)\n"
        "Documentation=https://github.com/dodry-question/vpntui\n"
        "After=network-online.target\n"
        "Wants=network-online.target\n"
        "\n"
        "[Service]\n"
        "Type=simple\n"
        f"ExecStart={core} run -c {GLOBAL_CONFIG}\n"
        "Restart=on-failure\n"
        "RestartSec=3\n"
        "NoNewPrivileges=true\n"
        "\n"
        "[Install]\n"
        "WantedBy=multi-user.target\n"
    )
    GLOBAL_DIR.mkdir(mode=0o755, parents=True, exist_ok=True)
    if not GLOBAL_UNIT.is_file() or GLOBAL_UNIT.read_text() != unit:
        GLOBAL_UNIT.write_text(unit)
        GLOBAL_UNIT.chmod(0o644)
        _systemctl("daemon-reload", check=True)


def global_start(watchdog=0, verify=True):
    raw = sys.stdin.read(MAX_CONFIG_LEN + 1)
    if len(raw) > MAX_CONFIG_LEN:
        raise SetupError("конфиг слишком большой")
    try:
        cfg = json.loads(raw)
    except json.JSONDecodeError as exc:
        raise SetupError(f"конфиг не JSON: {exc}") from exc
    validate_global_config(cfg)
    core = global_core()
    GLOBAL_DIR.mkdir(mode=0o755, parents=True, exist_ok=True)
    GLOBAL_CONFIG.write_text(json.dumps(cfg, ensure_ascii=False, indent=1))
    GLOBAL_CONFIG.chmod(0o644)
    _write_unit(core)
    _cancel_watchdog()
    # Автозапуск не включаем: глобальным режимом управляет кнопка в TUI.
    # Если нужен старт при загрузке — пользователь включает его сам (systemctl enable).
    _systemctl("disable", GLOBAL_SERVICE)
    # Исключение для zapret ставим до старта: правила zapret уже живут в ядре.
    zapret = ensure_zapret_exclusion(TUN_NAME)
    _systemctl("restart", GLOBAL_SERVICE)
    time.sleep(0.7)
    if not _service_active():
        log = _systemctl("status", GLOBAL_SERVICE, "--no-pager", "-n", "8")
        _systemctl("stop", GLOBAL_SERVICE)
        raise SetupError(
            "сервис не запустился:\n" + (log.stdout + log.stderr).strip()
        )
    if watchdog > 0:
        tool = shutil.which("systemd-run")
        if not tool:
            raise SetupError("systemd-run не найден, watchdog невозможен")
        subprocess.run(
            [tool, "--collect", "--unit", GLOBAL_WATCHDOG,
             f"--on-active={int(watchdog)}",
             shutil.which("systemctl") or "/usr/bin/systemctl",
             "stop", GLOBAL_SERVICE],
            capture_output=True, text=True, check=False,
        )
    # Интерфейс уже существует — повторяем (идемпотентно), чтобы правило
    # гарантированно стояло до первой проверки трафика.
    zapret = ensure_zapret_exclusion(TUN_NAME) or zapret
    has_tun = any(inbound.get("protocol") == "tun"
                  for inbound in cfg.get("inbounds") or [])
    result = {"service": GLOBAL_SERVICE, "zapret_excluded": bool(zapret)}
    if verify and has_tun:
        try:
            result.update(verify_tunnel(TUN_NAME))
        except SetupError:
            _cancel_watchdog()
            _systemctl("stop", GLOBAL_SERVICE)
            _systemctl("reset-failed", GLOBAL_SERVICE)
            raise
    print(json.dumps(result, ensure_ascii=False))
    return 0


def global_repair():
    """Apply every conflict fix that needs root, without starting the tunnel."""
    zapret = ensure_zapret_exclusion(TUN_NAME)
    print(json.dumps({"zapret_excluded": bool(zapret)}, ensure_ascii=False))
    return 0


def global_stop():
    _cancel_watchdog()
    _systemctl("stop", GLOBAL_SERVICE)
    time.sleep(0.3)
    if _service_active():
        raise SetupError("не удалось остановить сервис")
    return 0


def global_status():
    active = _service_active()
    print(json.dumps({
        "service": GLOBAL_SERVICE,
        "active": active,
        "config": str(GLOBAL_CONFIG),
        "core": str(SYSTEM_CORE) if SYSTEM_CORE.exists() else "",
    }, ensure_ascii=False))
    return 0 if active else 1


def global_main(argv):
    action = argv[0] if argv else "status"
    watchdog = 0
    verify = "--no-verify" not in argv
    if "--watchdog" in argv:
        try:
            watchdog = int(argv[argv.index("--watchdog") + 1])
        except (IndexError, ValueError):
            return 100
    try:
        if action == "start":
            return global_start(watchdog, verify=verify)
        if action == "stop":
            return global_stop()
        if action == "status":
            return global_status()
        if action == "repair":
            return global_repair()
        if action == "restart":
            _systemctl("restart", GLOBAL_SERVICE)
            return 0 if _service_active() else 100
    except SetupError as exc:
        msg(f"vpntui: {exc}")
        return 100
    msg(f"vpntui: неизвестное действие global: {action}")
    return 100



def main():
    if os.geteuid() != 0:
        msg("vpntui: нужен root (запускается через sudo)")
        return 100

    uid = int(os.environ.get("SUDO_UID") or 0)
    gid = int(os.environ.get("SUDO_GID") or 0)
    if uid == 0:
        msg("vpntui: отказываюсь работать для root")
        return 100

    if sys.argv[1:2] == ["global"]:
        return global_main(sys.argv[2:])

    try:
        req = json.loads(sys.stdin.read())
        cmd = req["cmd"]
        assert isinstance(cmd, list) and cmd and all(isinstance(c, str) and c for c in cmd)
    except Exception as e:
        msg(f"vpntui: некорректный запрос: {e}")
        return 100

    pw = pwd.getpwuid(uid)
    user, home = pw.pw_name, pw.pw_dir
    group = grp.getgrgid(gid).gr_name
    xray = str(req.get("xray") or "")
    if not xray or not os.path.isabs(xray) or not os.access(xray, os.X_OK):
        msg("vpntui: не передан исполняемый xray")
        return 100
    st = os.stat(xray)
    xray_as_user = st.st_uid != 0
    if xray_as_user:
        # A user-owned binary must never run as root: it would turn this
        # NOPASSWD helper into a local privilege escalation.  Run it as the
        # invoking user instead; TUN creation may then require a system core.
        msg("vpntui: пользовательское ядро Xray запускается без root-прав")

    cwd = req.get("cwd") or home
    if not os.path.isdir(cwd):
        cwd = home
    env = sanitize_env(req.get("env") or {}, home, user, group)
    tun = req["tun"]
    server = req.get("server") or {}

    RUN_DIR.mkdir(mode=0o755, parents=True, exist_ok=True)
    work = RUN_DIR / f"run-{os.getpid()}-{int(time.time())}"
    work.mkdir(mode=0o700)
    ns = f"avpn{os.getpid()}"
    cfg_path = work / "config.json"
    cfg_path.write_text(json.dumps(req["config"], ensure_ascii=False))
    cfg_path.chmod(0o600)

    SESS_DIR.mkdir(mode=0o755, exist_ok=True)
    cleanup_stale_sessions()
    log_path = RUN_DIR / f"{ns}.log"
    sess_path = SESS_DIR / f"{ns}.json"
    sess = {
        "ns": ns,
        "app": clean(str(req.get("app") or cmd[0])),
        "cmd": cmd,
        "server": {k: server.get(k) for k in
                   ("index", "name", "host", "port", "protocol", "ip")},
        "started": int(time.time()),
        "app_pid": None,
        "exit_ip": None,
        "country": None,
        "uid": uid,
        "user": user,
        "log": str(log_path),
        "state": "setup",
    }
    write_session(sess_path, sess)

    resolv = work / "resolv.conf"
    resolv.write_text("nameserver 1.1.1.1\nnameserver 8.8.8.8\n"
                      "options timeout:2 attempts:2 edns0\n")
    nsswitch = work / "nsswitch.conf"
    nsswitch.write_text("hosts: files dns myhostname\n")

    logf = open(log_path, "w")
    try:
        last = RUN_DIR / "last.log"
        last.unlink(missing_ok=True)
        last.symlink_to(log_path)
    except Exception:
        pass

    xray_p = slirp_p = app_p = None
    cleaned = False

    def cleanup():
        nonlocal cleaned
        if cleaned:
            return
        cleaned = True
        for p in (app_p, xray_p, slirp_p):
            if p and p.poll() is None:
                try:
                    p.terminate()
                except Exception:
                    pass
        deadline = time.time() + 5
        for p in (app_p, xray_p, slirp_p):
            if not p:
                continue
            try:
                p.wait(timeout=max(0.1, deadline - time.time()))
            except Exception:
                try:
                    p.kill()
                except Exception:
                    pass
        subprocess.run(["ip", "netns", "del", ns], capture_output=True)
        shutil.rmtree(work, ignore_errors=True)
        try:
            sess_path.unlink(missing_ok=True)
        except Exception:
            pass
        logf.close()

    def on_signal(signum, _frame):
        cleanup()
        sys.exit(128 + signum)

    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGINT, on_signal)

    try:
        # --- namespace + внешняя сеть -------------------------------------
        run(["ip", "netns", "add", ns])
        run(["ip", "netns", "exec", ns, "ip", "link", "set", "lo", "up"])
        run(["ip", "netns", "exec", ns, "sysctl", "-q", "-w",
             "net.ipv6.conf.all.disable_ipv6=1",
             "net.ipv6.conf.default.disable_ipv6=1"])
        slirp_p = start_slirp(ns, logf)

        # --- xray с TUN внутри namespace ----------------------------------
        xray_cmd = ["ip", "netns", "exec", ns, xray, "run", "-c", str(cfg_path)]
        if xray_as_user:
            xray_cmd = ["ip", "netns", "exec", ns, "setpriv",
                        f"--reuid={uid}", f"--regid={gid}", "--init-groups",
                        "--inh-caps=-all", "--bounding-set=-all", "--", xray,
                        "run", "-c", str(cfg_path)]
        xray_p = subprocess.Popen(xray_cmd, stdout=logf, stderr=logf)
        wait_link(ns, tun["name"])
        if xray_p.poll() is not None:
            raise SetupError("xray не смог стартовать")

        ns_ip(ns, "link", "set", tun["name"], "up")
        ns_ip(ns, "addr", "add", tun["addr"], "dev", tun["name"])

        # Всё — в TUN (table 100), кроме трафика с нашим fwmark.
        ns_ip(ns, "route", "add", "default", "dev", tun["name"], "table", str(tun["table"]))
        ns_ip(ns, "rule", "add", "pref", "100", "fwmark",
              hex(tun["mark"]), "lookup", "main")
        ns_ip(ns, "rule", "add", "pref", "200", "lookup", str(tun["table"]))

        # Bypass-маршруты к самому серверу (страховка от петли).
        gw = tun.get("gateway")
        for ip in server.get("ips") or []:
            subprocess.run(["ip", "netns", "exec", ns, "ip", "route", "replace",
                            f"{ip}/32", "via", gw, "dev", "tap0",
                            "table", str(tun["table"])], capture_output=True)

        if not req.get("no_check"):
            exit_ip = health_check(ns)
        else:
            exit_ip = "?"

        country = detect_country(ns, exit_ip) if exit_ip != "?" else ""
        need = (req.get("require_country") or "").upper()
        if country == "RU" and not req.get("allow_ru"):
            raise SetupError(
                f"выход через российский IP {exit_ip} (RU) — чат Roblox так не заработает.\n"
                "Выбери зарубежный сервер: run-vpn -l, затем run-vpn -s N ..."
            )
        if need and country and country != need:
            raise SetupError(
                f"выход через {country}, а требуется {need} (IP {exit_ip}). "
                "Смени сервер через -s."
            )
        cc = f" ({country})" if country else ""
        sess.update(exit_ip=exit_ip, country=country, state="up")
        write_session(sess_path, sess)
        msg(f"vpntui: туннель поднят, внешний IP {exit_ip}{cc} "
            f"(сервер {clean(str(server.get('name') or server.get('host') or '?'))})")
        if req.get("notify"):
            notify_user(env, uid, gid, "VPN: подключено",
                        f"IP {exit_ip}{cc} — вот так видит тебя сеть")

        # --- запуск приложения от имени пользователя ----------------------
        script = (
            "mount --make-rprivate /\n"
            f"mount --bind {shlex.quote(str(resolv))} /etc/resolv.conf\n"
            f"mount --bind {shlex.quote(str(nsswitch))} /etc/nsswitch.conf\n"
            f"exec setpriv --reuid={uid} --regid={gid} --init-groups -- \"$@\"\n"
        )
        app_p = subprocess.Popen(
            ["ip", "netns", "exec", ns, "unshare", "-m", "--propagation", "private",
             "--", "bash", "-c", script, "vpntui", *cmd],
            cwd=cwd, env=env,
        )
        sess.update(app_pid=app_p.pid, state="running")
        write_session(sess_path, sess)
        rc = app_p.wait()
        return rc
    except SetupError as e:
        msg(f"vpntui: {e}")
        try:
            logf.flush()
            tail = log_path.read_text(errors="replace").strip().splitlines()[-15:]
        except Exception:
            tail = []
        if tail:
            msg("--- лог " + str(log_path) + " ---")
            msg("\n".join(tail))
        return 100
    except FileNotFoundError as e:
        msg(f"vpntui: не найдена программа: {e}")
        return 100
    except Exception as e:
        msg(f"vpntui: ошибка: {e}")
        return 100
    finally:
        cleanup()


if __name__ == "__main__":
    sys.exit(main())
